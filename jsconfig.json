{
  "compilerOptions": {
    "baseUrl": "src",
    "paths": {
      "src/*": ["src/*"],
      "assets/*": ["src/assets/*"],
      "components/*": ["src/components/*"],
      "layout/*": ["src/components/layout/*"],
      "modules/*": ["src/components/modules/*"],
      "templates/*": ["src/components/templates/*"],
      "constants/*": ["src/constants/*"],
      "context/*": ["src/context/*"],
      "utils/*": ["src/utils/*"]
    }
  }
}
